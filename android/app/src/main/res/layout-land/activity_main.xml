<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏主界面：
    底部导航改成**右侧竖排**，把屏幕高度全留给内容；
    首页本身再分两栏（见 res/layout-land/view_home.xml）。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fitsSystemWindows="true">

    <!-- 内容区：三个页面容器 -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomNav">

        <include
            android:id="@+id/homePage"
            layout="@layout/view_home" />

        <include
            android:id="@+id/recordsPage"
            layout="@layout/view_records" />

        <include
            android:id="@+id/settingsPage"
            layout="@layout/view_settings" />
    </FrameLayout>

    <!-- 导航：横屏时竖排在右边 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="76dp"
        android:layout_height="0dp"
        android:background="@color/card_bg"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_home"
                    android:contentDescription="@string/tab_home" />

                <View
                    android:id="@+id/navHomeDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_blue_circle"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/navHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/blue_600" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecords"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/navRecordsIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_records_off"
                    android:contentDescription="@string/tab_records" />

                <View
                    android:id="@+id/navRecordsDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_blue_circle"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/navRecordsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_records"
                android:textSize="12sp"
                android:textColor="@color/ink_400" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_tab_settings_off"
                android:contentDescription="@string/tab_settings" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_settings"
                android:textSize="12sp"
                android:textColor="@color/ink_400" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
