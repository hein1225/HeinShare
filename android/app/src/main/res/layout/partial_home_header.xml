<?xml version="1.0" encoding="utf-8"?>
<!--
  首页头部（竖屏、横屏共用）：
    ① 品牌区  ② 手机广播开关卡  ③ Wi-Fi 提示
  单独拆出来是为了横屏时能把它放进左栏、列表放进右栏。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ① 品牌区：云朵图标 + 名称 + 副标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="@color/ink_900"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/ink_500"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ② 手机广播开关卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:elevation="3dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/switch_title"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_broadcast_phone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_title"
                    android:textColor="@color/ink_900"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/switch_desc"
                    android:textColor="@color/ink_500"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/discoverablePill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/switch_state_on"
                        android:textColor="@color/blue_700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/switchBox"
                        android:layout_width="64dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/switchTrack"
                            android:layout_width="64dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_toggle_on" />

                        <View
                            android:id="@+id/switchKnob"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="end"
                            android:layout_marginTop="3dp"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/bg_knob" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Wi-Fi 提示 -->
    <TextView
        android:id="@+id/wifiHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hint_warn"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="未连接 Wi-Fi，华为分享无法扫描到本机"
        android:textColor="@color/ink_700"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
