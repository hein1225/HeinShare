<?xml version="1.0" encoding="utf-8"?>
<!--
  首页列表区（竖屏、横屏共用）：
    ③ 附近设备（本次扫描扫到的）  ④ 连接历史（之前传输过的，带在线/离线）
  列表用 LinearLayout 而不是 RecyclerView：
  RecyclerView 嵌在 ScrollView 里只能量出一屏的高度，
  页面就滑不到底（横屏尤其明显）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ③ 附近设备 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- 标题行：标题 + 手动扫描 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nearbyTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nearby_title"
                android:textColor="@color/ink_900"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- 手动扫描：发现列表不靠自动刷新兜底，用户点一下立刻重扫 -->
            <LinearLayout
                android:id="@+id/scanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/scanButtonIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/scan_now"
                    android:src="@drawable/ic_refresh" />

                <TextView
                    android:id="@+id/scanButtonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/scan_now"
                    android:textColor="@color/blue_700"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 空态：手机广播图 + 说明，有设备时整体隐藏 -->
        <LinearLayout
            android:id="@+id/scanningBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:contentDescription="@string/scanning"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_broadcast_phone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scanningText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scanning"
                    android:textColor="@color/ink_900"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scanningHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/scanning_hint"
                    android:textColor="@color/ink_500"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 附近设备列表 -->
        <LinearLayout
            android:id="@+id/deviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ④ 连接历史：之前传输过的设备，标明在线/离线 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/ink_900"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/history_hint"
            android:textColor="@color/ink_500"
            android:textSize="13sp" />

        <!-- 历史为空时的提示 -->
        <TextView
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="@string/history_empty"
            android:textColor="@color/ink_400"
            android:textSize="13sp" />

        <!-- 连接历史列表 -->
        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
